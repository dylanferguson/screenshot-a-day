URL=https://example.com
BUCKET_NAME=my-screenshot-bucket
SUBDIR_PATH=screenshots
AWS_REGION=ap-southeast-2

# Optional local CLI login/SSO profile. Omit for workload roles.
# AWS_PROFILE=screenshot-a-day

# Use installed Chrome instead of running pnpm browser:install.
# BROWSER_CHANNEL=chrome

# Or supply a Chromium executable; do not also set BROWSER_CHANNEL.
# BROWSER_EXECUTABLE_PATH=/path/to/chromium
